{
  "version": 3,
  "configurePresets": [
    {
      "name": "debug",

      "binaryDir": "${sourceDir}/build/debug/intermediate/",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/debug/external"
      }
    },
    {
      "name": "release",
      "binaryDir": "${sourceDir}build/release/intermediate",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "FETCHCONTENT_BASE_DIR": "${sourceDir}/build/release/external/"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" }
  ]
}
